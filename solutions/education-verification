  /* Gradient text */
  .gradient-text{
    background: linear-gradient(135deg, #071A2b 0%, #2d5a1a 50%, #69be28 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  /* Buttons */
  .btn-primary{
    background: var(--primary);
    color: var(--secondary);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 4px 14px rgba(105,190,40,0.3);
  }
  .btn-primary:hover{
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(105,190,40,0.4);
  }
  .btn-secondary{
    background: transparent;
    color: var(--secondary);
    border: 1.5px solid var(--secondary);
    transition: all 0.3s ease;
  }
  .btn-secondary:hover{
    background: var(--secondary);
    color: var(--white);
    transform: translateY(-2px);
  }
  
  /* Fade in animation */
  .fade-up{
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.4,0,0.2,1);
  }
  .fade-up.visible{
    opacity: 1;
    transform: translateY(0);
  }
  
  /* Card hover */
  .feature-card{
    transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
    position: relative;
    overflow: hidden;
  }
  .feature-card::before{
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 3px;
    background: linear-gradient(90deg, transparent, #69be28, transparent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }
  .feature-card:hover::before{ transform: translateX(100%); }
  .feature-card:hover{
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(7,26,43,0.08);
    border-color: rgba(105,190,40,0.3);
  }
  
  /* Hero mockup styling */
  .dashboard-card{
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    box-shadow: 0 30px 60px -15px rgba(7,26,43,0.1), 0 0 0 1px rgba(7,26,43,0.02);
  }
  
  @keyframes drawCheck{ to{ stroke-dashoffset: 0; } }
  .check-path{
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: drawCheck 1.5s ease forwards;
  }
  
  .stripe-bg{
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(105,190,40,0.04) 10px,
      rgba(105,190,40,0.04) 20px
    );
  }
  
  .mobile-menu{
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
  }
  .mobile-menu.open{ transform: translateX(0); }
  
  ::selection{ background: #69be28; color: #071A2b; }
  
  .border-soft{ border: 1px solid rgba(7,26,43,0.08); }
  
  .stagger > *{
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s ease;
  }
  .stagger.visible > *{ opacity: 1; transform: translateY(0); }
  .stagger.visible > *:nth-child(1){ transition-delay: 0.05s; }
  .stagger.visible > *:nth-child(2){ transition-delay: 0.15s; }
  .stagger.visible > *:nth-child(3){ transition-delay: 0.25s; }
  .stagger.visible > *:nth-child(4){ transition-delay: 0.35s; }
  .stagger.visible > *:nth-child(5){ transition-delay: 0.45s; }
  .stagger.visible > *:nth-child(6){ transition-delay: 0.55s; }
  
  @keyframes verifyRing{
    0%,100%{ transform: scale(1); opacity: 0.6; }
    50%{ transform: scale(1.1); opacity: 1; }
  }
  .verify-ring{ animation: verifyRing 3s ease-in-out infinite; }
  
  html{ scroll-behavior: smooth; }
  
  /* Step Badge */
  .step-badge {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: #071A2b;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  
  /* Comic Card styling */
  .comic-card {
    transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
    border: 1px solid rgba(7,26,43,0.08);
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px -5px rgba(7,26,43,0.05);

    transform: translateY(-5px);
    box-shadow: 0 20px 40px -5px rgba(7,26,43,0.1);
    border-color: rgba(105,190,40,0.3);
  }
  
  /* FAQ Accordion (JS Driven for Desktop/Mobile/Tablet reliability) */
  .faq-item {
    border: 1px solid #e2e8f0;
    background: white;
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .faq-item.active {
    border-color: rgba(105,190,40,0.5);
    box-shadow: 0 10px 30px -5px rgba(105,190,40,0.1);
  }
  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    text-align: left;
    cursor: pointer;
    background: transparent;
    border: none;
    gap: 1rem;
  }
  .faq-trigger h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: #071A2b;
  }
  .faq-icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    background: rgba(105,190,40,0.1);
    color: #4f9e1a;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
  }
  .faq-item.active .faq-icon {
    transform: rotate(135deg);
    background: #69be28;
    color: #071A2b;
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-in-out;
  }
  .faq-answer-inner {
    padding: 0 1.5rem 1.5rem 1.5rem;
    color: #475569;
    line-height: 1.6;
  }
</style>
</head>
